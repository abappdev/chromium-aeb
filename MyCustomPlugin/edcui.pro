DEFINES += QT_NO_ICU

NOISE_C_DIR = $$PWD/../third_party/noise-c

# noise-c integration for the localhost policy transport.
DEFINES += ED25519_CUSTOMHASH ED25519_CUSTOMRANDOM

INCLUDEPATH += $$NOISE_C_DIR/include \
               $$NOISE_C_DIR/src \
               $$NOISE_C_DIR/src/protocol \
               $$NOISE_C_DIR/src/keys

